    { "type": "subtask_progress", "data": { "event_type": "task_complete", "batch_id": "retry", "task_id": "api", "child_session_id": "api-2", "attempt": 2, "sequence": 6, "task_name": "API Call", "status": "success", "duration": "2.0s" } },
