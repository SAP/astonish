    { "type": "subtask_progress", "data": { "event_type": "task_start", "batch_id": "retry", "task_id": "api", "child_session_id": "api-1", "attempt": 1, "sequence": 2, "task_name": "API Call" } },
    { "type": "subtask_progress", "data": { "event_type": "task_failed", "batch_id": "retry", "task_id": "api", "child_session_id": "api-1", "attempt": 1, "sequence": 3, "task_name": "API Call", "status": "error", "error": "429 rate limited", "duration": "0.5s" } },
    { "type": "subtask_progress", "data": { "event_type": "task_retry", "batch_id": "retry", "task_id": "api", "child_session_id": "api-2", "attempt": 2, "sequence": 4, "task_name": "API Call" } },
